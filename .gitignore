# Owner-only planning notes. Never committed.
/private/

# Data and large artifacts — paths documented in DATA.md, never committed (>10 MB rule)
# Anchored with a leading slash: a bare "data/" would also match
# minispatial/data/, silently excluding source files (caught 2026-09-07).
/data/
/artifacts/
/results/runs/
# ...but keep the read-only provenance records: DATA.md and FACTS.md cite these
# for every dataset number, so rule 1's audit trail must survive a fresh clone.
# They are a few KB of metadata, not data or artifacts.
!/results/runs/
/results/runs/*
!/results/runs/sen1floods11_survey.json
!/results/runs/split_csv_checksums.json
!/results/runs/sen1floods11_download.json
!/results/runs/teacher_eval.json
!/results/runs/teacher_eval_resize448.json
!/results/runs/teacher_eval_native.json
!/results/runs/logits_test_native512_manifest.json
!/results/runs/timing_tiny_tl_cpu.json

